{
  "compilerOptions": {
    "target": "ES6",                 
    "module": "ES6",                 
    "rootDir": "./src",              
    "outDir": "./dist",              

    "strict": true,                  
    "sourceMap": true,               
    "declaration": false,            

    "moduleResolution": "node",      
    "resolveJsonModule": true,       
    "isolatedModules": false,        
    "skipLibCheck": true             
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
